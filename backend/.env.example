APP_NAME="Nocfinity Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=secret

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Product and category images: "local" (public disk) or "cloudinary" (CDN with on-the-fly resizing).
MEDIA_DRIVER=local
# cloudinary://<api_key>:<api_secret>@<cloud_name> from https://console.cloudinary.com (free plan, no card).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=nocfinity

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Product search: meilisearch (typo-tolerant), database (MySQL FULLTEXT) or collection (tests).
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=local-dev-master-key-change-me

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@nocfinity-shop.test"
MAIL_FROM_NAME="${APP_NAME}"

# Shared secret between the Next.js server (BFF) and the API, so the BFF can pass on the visitor IP.
BFF_SHARED_SECRET=local-bff-secret-change-me
# Behind a platform edge that overwrites a client IP header (Railway: X-Real-IP), name it here.
CLIENT_IP_HEADER=

# Sanctum token lifetime in minutes (customer and staff tokens).
SANCTUM_EXPIRATION=10080

# Stripe test mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# Requests per minute; keep the defaults outside end-to-end test runs.
RATE_LIMIT_API=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHECKOUT=10

# Default Super Admin created by the seeder.
SUPER_ADMIN_EMAIL=superadmin@nocfinity-shop.test
SUPER_ADMIN_PASSWORD="SuperAdmin@123"
